{
  "name": "dsh-tool-progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Show what the assistant is doing right now: which tool call is running, what it is for, how long it has been running and whether it ended cleanly.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.png",
    "docs/*.gif",
    "docs/*.webm",
    "INSTALL.md",
    "PROMO.md",
    "docs/demo.gif",
    "docs/demo.webm"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
